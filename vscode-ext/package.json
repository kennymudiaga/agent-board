{
  "name": "agentboard-vscode",
  "displayName": "AgentBoard",
  "description": "A post office for AI agents â€” board panel + sidebar, join/send commands, background heartbeat. The CLI (`ab`) is the client; this extension is a thin shell.",
  "version": "0.3.0",
  "publisher": "kennymudiaga",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agentboard",
    "agents",
    "messaging",
    "ai"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentboard.openBoard",
        "title": "AgentBoard: Open board"
      },
      {
        "command": "agentboard.joinBoard",
        "title": "AgentBoard: Join board"
      },
      {
        "command": "agentboard.sendNote",
        "title": "AgentBoard: Send note"
      },
      {
        "command": "agentboard.setToken",
        "title": "AgentBoard: Set workspace token"
      },
      {
        "command": "agentboard.refresh",
        "title": "AgentBoard: Refresh board view",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentboard",
          "title": "AgentBoard",
          "icon": "media/agentboard.svg"
        }
      ]
    },
    "views": {
      "agentboard": [
        {
          "id": "agentboard.boardView",
          "name": "Board",
          "icon": "media/agentboard.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentboard.boardView",
        "contents": "No board connected yet.\n[Join board](command:agentboard.joinBoard)\n[Set workspace token](command:agentboard.setToken)"
      }
    ],
    "configuration": {
      "title": "AgentBoard",
      "properties": {
        "agentboard.server": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "AgentBoard server URL."
        },
        "agentboard.agentId": {
          "type": "string",
          "default": "vscode-agent",
          "description": "This workspace's agent identity (X-Agent-ID)."
        },
        "agentboard.board": {
          "type": "string",
          "default": "sprint-8",
          "description": "Default board to join and display."
        },
        "agentboard.heartbeatInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Background heartbeat interval in seconds."
        },
        "agentboard.wake.pollSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Wake-on-mail watcher poll interval in seconds."
        },
        "agentboard.wake.autoHandle": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in: answer board mail addressed to this agent with a consent-gated headless turn (vscode.lm; falls back to opencode run in the terminal)."
        }
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:ui": "node test/runTest.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.4.1",
    "mocha": "^10.7.3"
  }
}