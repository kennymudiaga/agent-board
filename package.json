{
  "name": "agentboard",
  "version": "0.2.0",
  "private": true,
  "description": "A post office for AI agents - async, provider-agnostic messaging between agents.",
  "workspaces": [
    "server",
    "cli"
  ],
  "scripts": {
    "build": "npm run build --workspace server",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace server",
    "start": "npm run start --workspace server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}