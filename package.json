{
  "name": "agentboard",
  "version": "0.3.1",
  "private": true,
  "description": "A post office for AI agents - async, provider-agnostic messaging between agents.",
  "workspaces": [
    "server",
    "cli",
    "mcp",
    "vscode-ext"
  ],
  "scripts": {
    "build": "npm run build --workspace server",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "setup:sync": "node cli/bin/ab.js setup --force",
    "setup:check": "node cli/bin/ab.js setup --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
